{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Generate Build Files",
      "type": "shell",
      "command": "cmake -B build -S .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Firmware",
      "type": "shell",
      "command": "make -C build",
      "group": "build",
      "dependsOn": "CMake: Generate Build Files",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash Firmware",
      "type": "shell",
      "command": "pyocd load ./build/py32-cmake.hex -t py32f002bx5 --config ./Misc/pyocd.yaml",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": "Build Firmware",
      "problemMatcher": []
    }
  ]
}
